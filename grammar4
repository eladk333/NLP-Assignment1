# Questions only at ROOT, so they can't appear inside a "that" clause.
2	ROOT	Q ?

# "did"/"will" + subject + verb phrase with the verb in its base form
# ("did Sally eat a sandwich ?", not "*did Sally ate a sandwich ?").
1	Q	Aux NP VPB
1	Aux	did
